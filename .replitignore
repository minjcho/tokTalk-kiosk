# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
/generated-artifacts/
/private-evaluation/

# Never package local credentials or captured customer data.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/.envrc
**/.netrc
**/.git-credentials
**/credentials.json
**/service-account*.json
**/id_rsa*
**/id_ed25519*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.dump
**/*.sql.gz
**/*.sql.zip
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.log
**/__pycache__/
/dumps/
/backups/
/recordings/
/test-results/
/playwright-report/
