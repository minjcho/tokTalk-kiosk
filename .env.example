# Documentation only: there are no real values in this file.
# Use Replit Secrets. The current scripts do NOT load a root .env automatically.
# PostgreSQL is required for ordering; Replit provides DATABASE_URL after setup.
DATABASE_URL=

# Server-only. Voice transcription, order parsing and speech consume OpenAI usage.
# Touch ordering does not require this key.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_ORDER_MODEL=gpt-5-mini

# Staff authentication only. Keep the secret key on the API server.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Public frontend configuration, not a server secret:
VITE_CLERK_PUBLISHABLE_KEY=
# Optional production Clerk proxy URL. Leave unset in development.
# Never include credentials or a signed URL.
# VITE_CLERK_PROXY_URL=

# Optional server logging:
LOG_LEVEL=info

# Per-service runtime variables are supplied by Replit's managed workflows.
# Do not set one global PORT/BASE_PATH for all six services.
# PORT=
# BASE_PATH=
# NODE_ENV=
# REPL_ID and REPLIT_DEV_DOMAIN are platform-provided, not user credentials.
# SESSION_SECRET is not read by this project's current source.
